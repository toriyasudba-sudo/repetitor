<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>TORIYA NOVA | Math Atelier</title>
    <!-- Telegram WebApp SDK -->
    <script src="https://telegram.org/js/telegram-web-app.js"></script>
    <!-- Supabase SDK -->
    <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
    <!-- Google Fonts: Cormorant Garamond & Montserrat -->
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,600;0,700;1,600&family=Montserrat:wght@400;500;600;700&display=swap" rel="stylesheet">
    
    <style>
        :root {
            --lv-dark: #1E140F;
            --lv-brown: #322118;
            --lv-gold: #C5A059;
            --lv-gold-light: #DFC286;
            --lv-cream: #FBF8F3;
            --lv-sand: #F2ECE1;
            --lv-text: #231711;
            --lv-muted: #7A6A5E;
            --lv-danger: #9E3B33;
            --lv-success: #2E5A44;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            -webkit-tap-highlight-color: transparent;
        }

        body {
            font-family: 'Montserrat', sans-serif;
            background-color: var(--lv-cream);
            color: var(--lv-text);
            line-height: 1.5;
            padding-bottom: 50px;
            background-image: radial-gradient(var(--lv-gold) 0.55px, transparent 0.55px);
            background-size: 24px 24px;
        }

        /* Luxury Header */
        .lv-header {
            background: linear-gradient(145deg, var(--lv-dark) 0%, var(--lv-brown) 100%);
            color: var(--lv-cream);
            padding: 22px 20px 18px;
            border-bottom: 2px solid var(--lv-gold);
            position: sticky;
            top: 0;
            z-index: 100;
            box-shadow: 0 6px 20px rgba(30, 20, 15, 0.25);
        }

        .lv-header-top {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .lv-brand {
            font-family: 'Cormorant Garamond', serif;
            font-size: 24px;
            font-weight: 700;
            letter-spacing: 2.5px;
            color: var(--lv-gold);
            text-transform: uppercase;
            user-select: none;
            cursor: pointer;
        }

        .lv-subtitle {
            font-size: 11px;
            text-transform: uppercase;
            letter-spacing: 1.8px;
            color: var(--lv-sand);
            margin-top: 4px;
            opacity: 0.85;
        }

        .admin-toggle-btn {
            background: rgba(197, 160, 89, 0.15);
            border: 1px solid var(--lv-gold);
            color: var(--lv-gold);
            padding: 6px 12px;
            border-radius: 20px;
            font-size: 11px;
            font-weight: 600;
            cursor: pointer;
            letter-spacing: 0.8px;
            transition: all 0.2s;
        }

        .admin-toggle-btn.active {
            background: var(--lv-gold);
            color: var(--lv-dark);
        }

        .container {
            max-width: 540px;
            margin: 0 auto;
            padding: 18px 16px;
        }

        /* Step Progress Bar */
        .progress-bar {
            display: flex;
            justify-content: space-between;
            margin-bottom: 22px;
            position: relative;
        }

        .progress-bar::before {
            content: '';
            position: absolute;
            top: 50%;
            left: 0;
            right: 0;
            height: 1px;
            background: var(--lv-gold);
            opacity: 0.4;
            z-index: 1;
        }

        .progress-step {
            width: 30px;
            height: 30px;
            border-radius: 50%;
            background: var(--lv-cream);
            border: 1px solid var(--lv-gold);
            color: var(--lv-muted);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 12px;
            font-weight: 600;
            position: relative;
            z-index: 2;
            transition: 0.3s;
        }

        .progress-step.active {
            background: var(--lv-dark);
            color: var(--lv-gold);
            border-color: var(--lv-gold);
            box-shadow: 0 0 0 4px rgba(197, 160, 89, 0.2);
        }

        .progress-step.done {
            background: var(--lv-gold);
            color: var(--lv-dark);
        }

        /* LV Cards */
        .lv-card {
            background: rgba(251, 248, 243, 0.96);
            border: 1px solid rgba(197, 160, 89, 0.45);
            border-radius: 14px;
            padding: 20px;
            margin-bottom: 18px;
            box-shadow: 0 8px 25px rgba(30, 20, 15, 0.06);
            position: relative;
            overflow: hidden;
        }

        .lv-card::after {
            content: '✦';
            position: absolute;
            top: 12px;
            right: 16px;
            color: var(--lv-gold);
            opacity: 0.4;
            font-size: 14px;
        }

        .lv-title {
            font-family: 'Cormorant Garamond', serif;
            font-size: 23px;
            font-weight: 700;
            color: var(--lv-dark);
            margin-bottom: 6px;
            letter-spacing: 0.5px;
        }

        .lv-desc {
            font-size: 13px;
            color: var(--lv-muted);
            margin-bottom: 18px;
        }

        /* Selectable Pills & Grid */
        .grid-2 {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px;
        }

        .lv-option {
            background: #fff;
            border: 1px solid rgba(197, 160, 89, 0.4);
            border-radius: 10px;
            padding: 13px 14px;
            font-size: 13px;
            font-weight: 500;
            color: var(--lv-text);
            cursor: pointer;
            transition: all 0.2s ease;
            display: flex;
            align-items: center;
            justify-content: space-between;
            text-align: left;
        }

        .lv-option.selected {
            background: var(--lv-dark);
            color: var(--lv-gold-light);
            border-color: var(--lv-gold);
            font-weight: 600;
            box-shadow: 0 4px 12px rgba(30, 20, 15, 0.18);
        }

        .lv-option .check-icon {
            width: 18px;
            height: 18px;
            border: 1px solid var(--lv-gold);
            border-radius: 4px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 11px;
            flex-shrink: 0;
            margin-left: 8px;
        }

        .lv-option.selected .check-icon {
            background: var(--lv-gold);
            color: var(--lv-dark);
        }

        /* Pricing Cards */
        .tariff-card {
            background: #fff;
            border: 1.5px solid rgba(197, 160, 89, 0.4);
            border-radius: 12px;
            padding: 16px;
            margin-bottom: 12px;
            cursor: pointer;
            transition: 0.25s;
        }

        .tariff-card.selected {
            background: linear-gradient(135deg, var(--lv-dark) 0%, var(--lv-brown) 100%);
            color: var(--lv-cream);
            border-color: var(--lv-gold);
            box-shadow: 0 8px 20px rgba(30, 20, 15, 0.22);
        }

        .tariff-badge {
            display: inline-block;
            background: var(--lv-gold);
            color: var(--lv-dark);
            font-size: 10px;
            font-weight: 700;
            text-transform: uppercase;
            padding: 3px 8px;
            border-radius: 4px;
            margin-bottom: 6px;
            letter-spacing: 0.8px;
        }

        .tariff-header {
            display: flex;
            justify-content: space-between;
            align-items: baseline;
            margin-bottom: 6px;
        }

        .tariff-name {
            font-family: 'Cormorant Garamond', serif;
            font-size: 20px;
            font-weight: 700;
        }

        .tariff-price {
            font-size: 18px;
            font-weight: 700;
            color: var(--lv-gold);
        }

        .tariff-sub {
            font-size: 12px;
            opacity: 0.8;
        }

        /* Inputs */
        .lv-input-group {
            margin-top: 14px;
        }

        .lv-label {
            display: block;
            font-size: 11px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: var(--lv-muted);
            margin-bottom: 6px;
        }

        .lv-input, .lv-textarea, .lv-select {
            width: 100%;
            padding: 13px 14px;
            border: 1px solid rgba(197, 160, 89, 0.5);
            border-radius: 10px;
            background: #fff;
            font-family: 'Montserrat', sans-serif;
            font-size: 13px;
            color: var(--lv-text);
            outline: none;
        }

        /* Buttons */
        .lv-btn {
            width: 100%;
            background: linear-gradient(135deg, var(--lv-dark) 0%, var(--lv-brown) 100%);
            color: var(--lv-gold-light);
            border: 1px solid var(--lv-gold);
            padding: 15px 20px;
            border-radius: 10px;
            font-family: 'Montserrat', sans-serif;
            font-size: 13px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 1.5px;
            cursor: pointer;
            transition: 0.25s;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            box-shadow: 0 6px 16px rgba(30, 20, 15, 0.2);
        }

        .lv-btn-secondary {
            background: transparent;
            color: var(--lv-muted);
            border: 1px solid rgba(197, 160, 89, 0.4);
            box-shadow: none;
        }

        .btn-row {
            display: flex;
            gap: 10px;
            margin-top: 18px;
        }

        /* Slots Grid */
        .slot-pill {
            background: #fff;
            border: 1px solid var(--lv-gold);
            border-radius: 10px;
            padding: 12px;
            text-align: center;
            cursor: pointer;
            transition: 0.2s;
        }

        .slot-pill .day {
            font-size: 11px;
            color: var(--lv-muted);
            text-transform: uppercase;
        }

        .slot-pill .time {
            font-size: 15px;
            font-weight: 700;
            color: var(--lv-dark);
            margin-top: 3px;
        }

        .slot-pill.selected {
            background: var(--lv-dark);
            border-color: var(--lv-gold);
        }

        .slot-pill.selected .day,
        .slot-pill.selected .time {
            color: var(--lv-gold-light);
        }

        /* Admin Tabs */
        .admin-nav {
            display: flex;
            gap: 6px;
            margin-bottom: 16px;
            background: var(--lv-sand);
            padding: 5px;
            border-radius: 10px;
            border: 1px solid rgba(197, 160, 89, 0.3);
        }

        .admin-tab {
            flex: 1;
            text-align: center;
            padding: 9px 6px;
            font-size: 11px;
            font-weight: 600;
            text-transform: uppercase;
            border-radius: 7px;
            cursor: pointer;
            color: var(--lv-muted);
        }

        .admin-tab.active {
            background: var(--lv-dark);
            color: var(--lv-gold);
        }

        .admin-item {
            background: #fff;
            border: 1px solid rgba(197, 160, 89, 0.35);
            border-radius: 10px;
            padding: 14px;
            margin-bottom: 10px;
        }

        .badge-status {
            display: inline-block;
            padding: 3px 8px;
            border-radius: 4px;
            font-size: 10px;
            font-weight: 700;
            text-transform: uppercase;
        }

        .badge-free { background: rgba(46, 90, 68, 0.12); color: var(--lv-success); }
        .badge-booked { background: rgba(158, 59, 51, 0.12); color: var(--lv-danger); }

        .hidden { display: none !important; }
        
        .toast {
            position: fixed;
            bottom: 20px;
            left: 50%;
            transform: translateX(-50%);
            background: var(--lv-dark);
            color: var(--lv-gold);
            border: 1px solid var(--lv-gold);
            padding: 12px 20px;
            border-radius: 30px;
            font-size: 12px;
            font-weight: 600;
            z-index: 999;
            box-shadow: 0 8px 25px rgba(0,0,0,0.35);
            text-align: center;
        }
    </style>
</head>
<body>

    <!-- ШАПКА LOUIS VUITTON -->
    <header class="lv-header">
        <div class="lv-header-top">
            <div>
                <!-- Секретный вход для браузера: 5 кликов подряд по логотипу -->
                <div class="lv-brand" onclick="handleSecretLogoTap()">✦ TORIYA NOVA ✦</div>
                <div class="lv-subtitle">Math Atelier & Architecture • @toriya_nova</div>
            </div>
            <!-- Кнопка СКРЫТА от всех клиентов! Появляется только для @toriya_nova -->
            <button id="adminToggleBtn" class="admin-toggle-btn hidden" onclick="toggleAdminView()">
                ♛ Дашборд
            </button>
        </div>
    </header>

    <div class="container">

        <!-- ================= КЛИЕНТСКАЯ ЧАСТЬ (БЕЗ ПАРОЛЯ) ================= -->
        <div id="clientView">
            
            <div class="progress-bar">
                <div class="progress-step active" id="pStep1">I</div>
                <div class="progress-step" id="pStep2">II</div>
                <div class="progress-step" id="pStep3">III</div>
                <div class="progress-step" id="pStep4">IV</div>
            </div>

            <!-- ШАГ 1: ВЫБОР КЛАССА И ЦЕЛИ -->
            <div id="step1" class="lv-card">
                <div class="lv-title">I. Диагностика: Класс и цель</div>
                <div class="lv-desc">Выберите класс ученика, чтобы система подобрала нужные темы по математике:</div>
                
                <div class="grid-2" id="gradeList">
                    <div class="lv-option" onclick="selectGrade('1–4 класс (Начальная школа)', this)">
                        <span>1–4 класс</span><span class="check-icon">✦</span>
                    </div>
                    <div class="lv-option" onclick="selectGrade('5–6 класс (База и логика)', this)">
                        <span>5–6 класс</span><span class="check-icon">✦</span>
                    </div>
                    <div class="lv-option" onclick="selectGrade('7–8 класс (Алгебра / Геометрия)', this)">
                        <span>7–8 класс</span><span class="check-icon">✦</span>
                    </div>
                    <div class="lv-option" onclick="selectGrade('9 класс (Подготовка к ОГЭ)', this)">
                        <span>9 класс (ОГЭ)</span><span class="check-icon">✦</span>
                    </div>
                    <div class="lv-option" onclick="selectGrade('10–11 класс (Профиль / ЕГЭ)', this)">
                        <span>10–11 класс</span><span class="check-icon">✦</span>
                    </div>
                    <div class="lv-option" onclick="selectGrade('Международная программа (Eng/VN)', this)">
                        <span>Междунар. программа</span><span class="check-icon">✦</span>
                    </div>
                </div>

                <div class="lv-input-group" style="margin-top: 20px;">
                    <label class="lv-label">Главная задача сейчас:</label>
                    <select id="goalSelect" class="lv-select">
                        <option value="Подтянуть текущую успеваемость и оценки">Подтянуть текущую успеваемость и оценки</option>
                        <option value="Убрать страх перед математикой и закрыть пробелы">Убрать страх перед предметом и закрыть пробелы</option>
                        <option value="Помощь с домашними заданиями и контрольными">Помощь с домашками и контрольными</option>
                        <option value="Системная подготовка к экзаменам (ОГЭ/ЕГЭ)">Системная подготовка к экзаменам</option>
                        <option value="Углубленная математика на опережение">Углубленная математика на опережение</option>
                    </select>
                </div>

                <div class="btn-row">
                    <button class="lv-btn" onclick="goToStep(2)">Далее к темам ➔</button>
                </div>
            </div>

            <!-- ШАГ 2: МУЛЬТИВЫБОР ТЕМ + СВОЙ ВАРИАНТ -->
            <div id="step2" class="lv-card hidden">
                <div class="lv-title">II. Какие темы вызывают сложности?</div>
                <div class="lv-desc">Можно выбрать <b>несколько вариантов</b> из списка или вписать свою тему ниже:</div>
                
                <div id="topicsContainer" style="display: flex; flex-direction: column; gap: 8px;"></div>

                <div class="lv-input-group">
                    <label class="lv-label">Свой вариант / комментарий по темам (необязательно):</label>
                    <textarea id="customTopicInput" class="lv-textarea" rows="2" placeholder="Например: путается в знаках при раскрытии скобок, нужна геометрия с нуля..."></textarea>
                </div>

                <div class="btn-row">
                    <button class="lv-btn lv-btn-secondary" style="width: 40%;" onclick="goToStep(1)">Назад</button>
                    <button class="lv-btn" style="width: 60%;" onclick="goToStep(3)">К тарифам ➔</button>
                </div>
            </div>

            <!-- ШАГ 3: ТАРИФЫ И АБОНЕМЕНТЫ (350 ДОНГОВ) -->
            <div id="step3" class="lv-card hidden">
                <div class="lv-title">III. Формат и стоимость занятий</div>
                <div class="lv-desc">Выберите разовый урок-диагностику или выгодный абонемент с закреплением времени:</div>

                <div class="tariff-card selected" onclick="selectTariff('Разовое занятие — 350.000 ₫', this)">
                    <span class="tariff-badge">Старт и диагностика</span>
                    <div class="tariff-header">
                        <div class="tariff-name">1 Занятие (Индивидуально)</div>
                        <div class="tariff-price">350.000 ₫</div>
                    </div>
                    <div class="tariff-sub">Разбор сложной темы, полная диагностика знаний и план обучения (350k VND).</div>
                </div>

                <div class="tariff-card" onclick="selectTariff('Абонемент 4 урока — 1.300.000 ₫', this)">
                    <span class="tariff-badge">Популярный выбор</span>
                    <div class="tariff-header">
                        <div class="tariff-name">Абонемент • 4 занятия</div>
                        <div class="tariff-price">1.300.000 ₫</div>
                    </div>
                    <div class="tariff-sub">325.000 ₫ за урок. Фиксация постоянного слота в расписании + проверка ДЗ.</div>
                </div>

                <div class="tariff-card" onclick="selectTariff('Абонемент 8 уроков — 2.400.000 ₫', this)">
                    <span class="tariff-badge">Максимальный результат</span>
                    <div class="tariff-header">
                        <div class="tariff-name">Абонемент • 8 занятий</div>
                        <div class="tariff-price">2.400.000 ₫</div>
                    </div>
                    <div class="tariff-sub">300.000 ₫ за урок (выгода 400k ₫). Полное ведение ученика и связь в Telegram @toriya_nova.</div>
                </div>

                <div class="btn-row">
                    <button class="lv-btn lv-btn-secondary" style="width: 40%;" onclick="goToStep(2)">Назад</button>
                    <button class="lv-btn" style="width: 60%;" onclick="goToStep(4)">Выбрать время ➔</button>
                </div>
            </div>

            <!-- ШАГ 4: СВОБОДНЫЕ СЛОТЫ И БРОНЬ -->
            <div id="step4" class="lv-card hidden">
                <div class="lv-title">IV. Свободные окошки для записи</div>
                <div class="lv-desc">Расписание обновляется в реальном времени. Как только вы выбираете слот, он автоматически закрывается за вами:</div>

                <div id="slotsGrid" class="grid-2" style="margin-bottom: 18px;"></div>

                <div class="lv-input-group">
                    <label class="lv-label">Имя ученика / родителя *</label>
                    <input type="text" id="clientName" class="lv-input" placeholder="Например: Анна (сын Марк)">
                </div>

                <div class="lv-input-group">
                    <label class="lv-label">Ваш Telegram (@username или телефон) *</label>
                    <input type="text" id="clientTg" class="lv-input" placeholder="@username">
                </div>

                <div class="btn-row">
                    <button class="lv-btn lv-btn-secondary" style="width: 35%;" onclick="goToStep(3)">Назад</button>
                    <button class="lv-btn" id="submitBookingBtn" style="width: 65%;" onclick="submitBooking()">
                        ✦ Забронировать слот
                    </button>
                </div>
            </div>

            <!-- ЭКРАН УСПЕШНОЙ ЗАПИСИ -->
            <div id="successScreen" class="lv-card hidden" style="text-align: center; padding: 32px 20px;">
                <div style="font-size: 42px; color: var(--lv-gold); margin-bottom: 10px;">♛</div>
                <div class="lv-title" style="font-size: 26px;">Слот успешно закреплен за вами!</div>
                <p class="lv-desc" id="bookingSummaryText" style="margin-top: 10px; font-size: 14px; color: var(--lv-text);"></p>
                <div style="background: var(--lv-sand); padding: 14px; border-radius: 10px; margin: 18px 0; font-size: 13px;">
                    Связь с преподавателем и учебные материалы — напрямую в Telegram: <b>@toriya_nova</b>
                </div>
                <a id="directTgLink" href="https://t.me/toriya_nova" target="_blank" class="lv-btn" style="text-decoration: none;">
                    Написать Тории в Telegram ➔
                </a>
            </div>

        </div>

        <!-- ================= ЗАЩИЩЕННЫЙ ВХОД В АДМИНКУ (ТОЛЬКО ДЛЯ ТОРИИ) ================= -->
        <div id="adminAuthModal" class="lv-card hidden">
            <div class="lv-title">♛ Вход для @toriya_nova</div>
            <div class="lv-desc">База данных защищена RLS. Введи свой секретный ключ администратора, чтобы управлять слотами и журналом:</div>
            <input type="password" id="adminSecretInput" class="lv-input" placeholder="Секретный ключ БД (напр. ToriyaLV2026!)">
            <div class="btn-row">
                <button class="lv-btn lv-btn-secondary" style="width:40%;" onclick="closeAdminAuth()">Отмена</button>
                <button class="lv-btn" style="width:60%;" onclick="unlockAdminDashboard()">Войти в Дашборд</button>
            </div>
        </div>

        <!-- ================= ДАШБОРД ПРЕПОДАВАТЕЛЯ (АДМИНКА ТОРИИ) ================= -->
        <div id="adminView" class="hidden">
            <div class="admin-nav">
                <div class="admin-tab active" id="tabBtnSlots" onclick="switchAdminTab('slots')">📅 Слоты</div>
                <div class="admin-tab" id="tabBtnLeads" onclick="switchAdminTab('leads')">🔥 Заявки</div>
                <div class="admin-tab" id="tabBtnJournal" onclick="switchAdminTab('journal')">📚 Мой журнал ДЗ</div>
            </div>

            <!-- ВКЛАДКА 1: УПРАВЛЕНИЕ СЛОТАМИ -->
            <div id="adminTabSlots" class="lv-card">
                <div class="lv-title">Управление расписанием</div>
                <div class="lv-desc">Добавляй свободные окошки. Когда клиент записывается, слот автоматически становится «Занят».</div>

                <div class="grid-2">
                    <div>
                        <label class="lv-label">День недели / Дата</label>
                        <input type="text" id="newSlotDay" class="lv-input" placeholder="Среда, 21 окт">
                    </div>
                    <div>
                        <label class="lv-label">Время (Вьетнам)</label>
                        <input type="text" id="newSlotTime" class="lv-input" placeholder="16:00 - 17:00">
                    </div>
                </div>
                <button class="lv-btn" style="margin-top: 12px; padding: 12px;" onclick="addAdminSlot()">+ Открыть новый слот</button>

                <hr style="border: none; border-top: 1px solid rgba(197,160,89,0.3); margin: 20px 0;">
                <div id="adminSlotsList"></div>
            </div>

            <!-- ВКЛАДКА 2: ВХОДЯЩИЕ ЗАЯВКИ ИЗ ДИАГНОСТИКИ -->
            <div id="adminTabLeads" class="lv-card hidden">
                <div class="lv-title">Заявки с диагностики</div>
                <div class="lv-desc">Все ответы новых учеников, выбранные темы и забронированные слоты:</div>
                <div id="adminLeadsList"></div>
            </div>

            <!-- ВКЛАДКА 3: ЛИЧНЫЙ ЖУРНАЛ ТОРИИ (ЧТО ЗАДАНО) -->
            <div id="adminTabJournal" class="lv-card hidden">
                <div class="lv-title">Личный журнал учеников и ДЗ</div>
                <div class="lv-desc">Твоя закрытая база: отмечаешь, что прошли, что задано на дом и остаток уроков по абонементу:</div>

                <div style="background: var(--lv-sand); padding: 14px; border-radius: 10px; margin-bottom: 16px;">
                    <div class="grid-2">
                        <input type="text" id="jStudentName" class="lv-input" placeholder="Имя ученика и класс">
                        <input type="number" id="jLessonsLeft" class="lv-input" placeholder="Остаток уроков (напр. 4)" value="4">
                    </div>
                    <input type="text" id="jLastTopic" class="lv-input" style="margin-top: 8px;" placeholder="Какую тему разобрали на уроке">
                    <textarea id="jHomework" class="lv-textarea" rows="2" style="margin-top: 8px;" placeholder="Что задано на дом (номера, тренажер, файл)..."></textarea>
                    <button class="lv-btn" style="margin-top: 10px; padding: 11px;" onclick="addJournalEntry()">+ Сохранить запись в журнал</button>
                </div>

                <div id="adminJournalList"></div>
            </div>
        </div>

    </div>

    <div id="toast" class="toast hidden"></div>

    <script>
        // =========================================================================
        // 1. КОНФИГУРАЦИЯ SUPABASE (Публичный URL и ANON KEY безопасны благодаря RLS!)
        // =========================================================================
        const SUPABASE_URL = ""; 
        const SUPABASE_ANON_KEY = "";
        const ADMIN_TG_USERNAME = "toriya_nova";

        let sb = null;
        if (SUPABASE_URL && SUPABASE_ANON_KEY && window.supabase) {
            sb = window.supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY);
        }

        // Хранение секретного ключа админа в сессии устройства Тории
        let adminSecretKey = localStorage.getItem('lv_admin_secret_key') || '';

        // Инициализация Telegram WebApp и проверка: если зашла сама @toriya_nova — показываем кнопку Дашборда
        const tg = window.Telegram?.WebApp;
        if (tg) {
            tg.expand();
            const user = tg.initDataUnsafe?.user;
            if (user) {
                if (user.first_name) document.getElementById('clientName').value = user.first_name;
                if (user.username) {
                    document.getElementById('clientTg').value = '@' + user.username;
                    // ТОЛЬКО если ник совпадает с toriya_nova, показываем кнопку Дашборда!
                    if (user.username.toLowerCase() === ADMIN_TG_USERNAME.toLowerCase()) {
                        document.getElementById('adminToggleBtn').classList.remove('hidden');
                    }
                }
            }
        }

        // Если Тория уже авторизовывалась на этом телефоне/ноутбуке ранее — тоже показываем кнопку
        if (adminSecretKey) {
            document.getElementById('adminToggleBtn').classList.remove('hidden');
        }

        // Секретный жест для входа с ноутбука/браузера: 5 быстрых кликов по логотипу "✦ TORIYA NOVA ✦"
        let logoTapCount = 0;
        let logoTapTimer = null;
        function handleSecretLogoTap() {
            logoTapCount++;
            clearTimeout(logoTapTimer);
            logoTapTimer = setTimeout(() => { logoTapCount = 0; }, 1500);
            if (logoTapCount >= 5) {
                logoTapCount = 0;
                document.getElementById('adminToggleBtn').classList.remove('hidden');
                toggleAdminView();
            }
        }

        // Справочник тем по классам
        const TOPICS_BY_GRADE = {
            '1–4 класс (Начальная школа)': [
                'Таблица умножения и устный счет',
                'Текстовые задачи на движение и логику',
                'Дроби и доли (начальный уровень)',
                'Периметр, площадь, единицы измерения',
                'Уравнения в несколько действий'
            ],
            '5–6 класс (База и логика)': [
                'НОД и НОК (делители и кратные)',
                'Обыкновенные и десятичные дроби',
                'Проценты, пропорции и отношения',
                'Положительные и отрицательные числа',
                'Раскрытие скобок и линейные уравнения'
            ],
            '7–8 класс (Алгебра / Геометрия)': [
                'Формулы сокращенного умножения (ФСУ)',
                'Системы уравнений и функции (графики)',
                'Степени, корни и квадратные уравнения',
                'Геометрия: треугольники, признаки равенства, теорема Пифагора',
                'Алгебраические дроби и неравенства'
            ],
            '9 класс (Подготовка к ОГЭ)': [
                'Модуль «Алгебра» (задания 6–14 ОГЭ)',
                'Модуль «Геометрия» (задания 15–19, чтобы не завалить)',
                'Текстовые задачи (проценты, сплавы, движение — №21)',
                'Функции и параболы (вторая часть)',
                'Практико-ориентированные задачи (шины, участки, печи — №1–5)'
            ],
            '10–11 класс (Профиль / ЕГЭ)': [
                'Тригонометрия и логарифмы',
                'Производная и исследование функций',
                'Стереометрия и планиметрия',
                'Финансовая математика (кредиты и вклады)',
                'Сложные уравнения и неравенства 2-й части'
            ],
            'Международная программа (Eng/VN)': [
                'Fractions, Decimals & Percentages',
                'Algebraic Expressions & Linear Equations',
                'Geometry & Measurement',
                'Word Problems & Mathematical Logic',
                'Cambridge / IB / Bilingual Curriculum Support'
            ]
        };

        let state = {
            grade: '',
            goal: '',
            topics: [],
            customTopic: '',
            tariff: 'Разовое занятие — 350.000 ₫',
            selectedSlotId: null,
            selectedSlotLabel: ''
        };

        const DEFAULT_SLOTS = [
            { id: 'slot-1', day_label: 'Вторник', time_range: '15:00 - 16:00', is_booked: false, booked_by_name: '', booked_by_tg: '' },
            { id: 'slot-2', day_label: 'Среда', time_range: '16:30 - 17:30', is_booked: false, booked_by_name: '', booked_by_tg: '' },
            { id: 'slot-3', day_label: 'Четверг', time_range: '15:00 - 16:00', is_booked: true, booked_by_name: 'Марк (6 кл)', booked_by_tg: '@parent_mark' },
            { id: 'slot-4', day_label: 'Пятница', time_range: '17:00 - 18:00', is_booked: false, booked_by_name: '', booked_by_tg: '' },
            { id: 'slot-5', day_label: 'Суббота', time_range: '11:00 - 12:00', is_booked: false, booked_by_name: '', booked_by_tg: '' }
        ];

        const DEFAULT_JOURNAL = [
            { id: 'j-1', student_name: 'Марк • 6 класс', last_topic: 'НОД и НОК, разложение на множители', homework: 'Решить карточку №4 (задачи 1–6 на НОК)', lessons_left: 3 }
        ];

        function showToast(msg) {
            const t = document.getElementById('toast');
            t.textContent = msg;
            t.classList.remove('hidden');
            setTimeout(() => t.classList.add('hidden'), 3200);
        }

        // Публичное чтение ТОЛЬКО свободных слотов
        async function fetchPublicFreeSlots() {
            if (sb) {
                const { data, error } = await sb.from('tutor_slots').select('id, day_label, time_range, is_booked').eq('is_booked', false).order('created_at', { ascending: true });
                if (!error && data) return data;
            }
            const raw = localStorage.getItem('lv_tutor_slots');
            const all = raw ? JSON.parse(raw) : DEFAULT_SLOTS;
            if (!raw) localStorage.setItem('lv_tutor_slots', JSON.stringify(DEFAULT_SLOTS));
            return all.filter(s => !s.is_booked);
        }

        // ================= ЛОГИКА ШАГОВ КЛИЕНТА =================
        function selectGrade(gradeName, el) {
            state.grade = gradeName;
            state.topics = [];
            document.querySelectorAll('#gradeList .lv-option').forEach(o => o.classList.remove('selected'));
            el.classList.add('selected');
            renderTopicsForGrade(gradeName);
        }

        function renderTopicsForGrade(gradeName) {
            const container = document.getElementById('topicsContainer');
            const list = TOPICS_BY_GRADE[gradeName] || TOPICS_BY_GRADE['5–6 класс (База и логика)'];
            container.innerHTML = '';
            list.forEach(topic => {
                const div = document.createElement('div');
                div.className = 'lv-option';
                div.innerHTML = `<span>${topic}</span><span class="check-icon">✓</span>`;
                div.onclick = () => {
                    div.classList.toggle('selected');
                    if (state.topics.includes(topic)) {
                        state.topics = state.topics.filter(t => t !== topic);
                    } else {
                        state.topics.push(topic);
                    }
                };
                container.appendChild(div);
            });
        }

        function selectTariff(tariffName, el) {
            state.tariff = tariffName;
            document.querySelectorAll('.tariff-card').forEach(c => c.classList.remove('selected'));
            el.classList.add('selected');
        }

        async function renderClientSlots() {
            const freeSlots = await fetchPublicFreeSlots();
            const grid = document.getElementById('slotsGrid');
            grid.innerHTML = '';

            if (freeSlots.length === 0) {
                grid.innerHTML = `<div style="grid-column: 1 / -1; text-align: center; padding: 16px; color: var(--lv-muted); font-size: 13px;">На этой неделе все окошки разобрали! Напишите @toriya_nova для подбора индивидуального времени.</div>`;
                return;
            }

            freeSlots.forEach(slot => {
                const div = document.createElement('div');
                div.className = 'slot-pill' + (state.selectedSlotId === slot.id ? ' selected' : '');
                div.innerHTML = `<div class="day">${slot.day_label}</div><div class="time">${slot.time_range}</div>`;
                div.onclick = () => {
                    state.selectedSlotId = slot.id;
                    state.selectedSlotLabel = `${slot.day_label} (${slot.time_range})`;
                    document.querySelectorAll('.slot-pill').forEach(p => p.classList.remove('selected'));
                    div.classList.add('selected');
                };
                grid.appendChild(div);
            });
        }

        function goToStep(stepNumber) {
            if (stepNumber === 2 && !state.grade) {
                showToast('Пожалуйста, выберите класс ученика');
                return;
            }
            if (stepNumber === 3) {
                state.customTopic = document.getElementById('customTopicInput').value.trim();
                if (state.topics.length === 0 && !state.customTopic) {
                    showToast('Выберите хотя бы одну тему или впишите свою');
                    return;
                }
            }
            if (stepNumber === 4) {
                renderClientSlots();
            }

            [1, 2, 3, 4].forEach(n => {
                document.getElementById('step' + n).classList.toggle('hidden', n !== stepNumber);
                const p = document.getElementById('pStep' + n);
                p.classList.remove('active', 'done');
                if (n < stepNumber) p.classList.add('done');
                if (n === stepNumber) p.classList.add('active');
            });
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        // ================= АТОМАРНАЯ ЗАПИСЬ С ЗАЩИТОЙ ОТ ДВОЙНОЙ БРОНИ =================
        async function submitBooking() {
            const name = document.getElementById('clientName').value.trim();
            const tgUser = document.getElementById('clientTg').value.trim();
            state.goal = document.getElementById('goalSelect').value;
            state.customTopic = document.getElementById('customTopicInput').value.trim();

            if (!state.selectedSlotId) {
                showToast('Выберите свободный слот расписания');
                return;
            }
            if (!name || !tgUser) {
                showToast('Укажите ваше имя и Telegram для связи');
                return;
            }

            const btn = document.getElementById('submitBookingBtn');
            btn.disabled = true;
            btn.textContent = 'Бронируем...';

            if (sb) {
                const { data, error } = await sb.rpc('book_tutor_slot', {
                    p_slot_id: state.selectedSlotId,
                    p_student_name: name,
                    p_tg_username: tgUser,
                    p_grade: state.grade,
                    p_topics: state.topics,
                    p_custom_topic: state.customTopic,
                    p_goal: state.goal,
                    p_tariff: state.tariff,
                    p_slot_snapshot: state.selectedSlotLabel
                });

                btn.disabled = false;
                btn.textContent = '✦ Забронировать слот';

                if (error || (data && !data.success)) {
                    showToast(data?.error || 'Этот слот только что заняли! Выберите другой.');
                    state.selectedSlotId = null;
                    await renderClientSlots();
                    return;
                }
            } else {
                const slots = JSON.parse(localStorage.getItem('lv_tutor_slots') || JSON.stringify(DEFAULT_SLOTS));
                const target = slots.find(s => s.id === state.selectedSlotId);
                if (!target || target.is_booked) {
                    btn.disabled = false;
                    btn.textContent = '✦ Забронировать слот';
                    showToast('Упс! Этот слот только что забрали. Выберите другое окно.');
                    state.selectedSlotId = null;
                    await renderClientSlots();
                    return;
                }
                target.is_booked = true;
                target.booked_by_name = name;
                target.booked_by_tg = tgUser;
                localStorage.setItem('lv_tutor_slots', JSON.stringify(slots));

                const leads = JSON.parse(localStorage.getItem('lv_tutor_leads') || '[]');
                leads.unshift({
                    id: 'lead-' + Date.now(),
                    student_name: name,
                    tg_username: tgUser,
                    grade: state.grade,
                    topics: state.topics,
                    custom_topic: state.customTopic,
                    goal: state.goal,
                    tariff: state.tariff,
                    slot_snapshot: state.selectedSlotLabel,
                    created_at: new Date().toISOString()
                });
                localStorage.setItem('lv_tutor_leads', JSON.stringify(leads));
                btn.disabled = false;
            }

            document.getElementById('step4').classList.add('hidden');
            document.getElementById('successScreen').classList.remove('hidden');

            const allTopics = [...state.topics, state.customTopic].filter(Boolean).join(', ');
            document.getElementById('bookingSummaryText').innerHTML = `
                <b>${name}</b>, за вами забронировано окно: <br>
                <span style="color: var(--lv-dark); font-weight:700;">${state.selectedSlotLabel}</span><br><br>
                <b>Класс:</b> ${state.grade}<br>
                <b>Тариф:</b> ${state.tariff}<br>
                <b>Темы:</b> ${allTopics}
            `;

            const prefilledMsg = encodeURIComponent(
                `Привет, Тория! ✦ Записались через твой Math Atelier:\n` +
                `👤 Ученик: ${name} (${state.grade})\n` +
                `📅 Слот: ${state.selectedSlotLabel}\n` +
                `💎 Тариф: ${state.tariff}\n` +
                `📚 Темы: ${allTopics}`
            );
            document.getElementById('directTgLink').href = `https://t.me/${ADMIN_TG_USERNAME}?text=${prefilledMsg}`;
        }

        // ================= ЗАЩИЩЕННАЯ АДМИН-ПАНЕЛЬ (ТОЛЬКО С КЛЮЧОМ ТОРИИ) =================
        function toggleAdminView() {
            const clientView = document.getElementById('clientView');
            const adminView = document.getElementById('adminView');
            const authModal = document.getElementById('adminAuthModal');
            const btn = document.getElementById('adminToggleBtn');

            if (!adminView.classList.contains('hidden') || !authModal.classList.contains('hidden')) {
                // Выход обратно в анкету
                adminView.classList.add('hidden');
                authModal.classList.add('hidden');
                clientView.classList.remove('hidden');
                btn.classList.remove('active');
                btn.textContent = '♛ Дашборд';
                renderClientSlots();
                return;
            }

            clientView.classList.add('hidden');
            btn.classList.add('active');
            btn.textContent = '← В анкету';

            if (!adminSecretKey) {
                authModal.classList.remove('hidden');
            } else {
                adminView.classList.remove('hidden');
                renderAdminDashboard();
            }
        }

        function closeAdminAuth() {
            document.getElementById('adminAuthModal').classList.add('hidden');
            document.getElementById('clientView').classList.remove('hidden');
            const btn = document.getElementById('adminToggleBtn');
            btn.classList.remove('active');
            btn.textContent = '♛ Дашборд';
        }

        async function unlockAdminDashboard() {
            const keyInput = document.getElementById('adminSecretInput').value.trim();
            if (!keyInput) {
                showToast('Введи секретный ключ');
                return;
            }
            adminSecretKey = keyInput;
            const ok = await renderAdminDashboard();
            if (ok) {
                localStorage.setItem('lv_admin_secret_key', adminSecretKey);
                document.getElementById('adminAuthModal').classList.add('hidden');
                document.getElementById('adminView').classList.remove('hidden');
                showToast('Добро пожаловать, Тория ♛');
            } else {
                adminSecretKey = '';
                localStorage.removeItem('lv_admin_secret_key');
            }
        }

        function switchAdminTab(tab) {
            ['slots', 'leads', 'journal'].forEach(t => {
                document.getElementById('adminTab' + t.charAt(0).toUpperCase() + t.slice(1)).classList.toggle('hidden', t !== tab);
                document.getElementById('tabBtn' + t.charAt(0).toUpperCase() + t.slice(1)).classList.toggle('active', t === tab);
            });
            renderAdminDashboard();
        }

        async function renderAdminDashboard() {
            let slots = [];
            let leads = [];
            let journal = [];

            if (sb) {
                const { data, error } = await sb.rpc('admin_get_dashboard', { p_secret: adminSecretKey });
                if (error || !data || !data.success) {
                    showToast(data?.error || 'Неверный секретный ключ БД!');
                    document.getElementById('adminView').classList.add('hidden');
                    document.getElementById('adminAuthModal').classList.remove('hidden');
                    return false;
                }
                slots = data.slots || [];
                leads = data.leads || [];
                journal = data.journal || [];
            } else {
                // В демо-режиме проверяем дефолтный пароль ToriyaLV2026!
                if (adminSecretKey !== 'ToriyaLV2026!') {
                    showToast('Неверный ключ! (Для теста: ToriyaLV2026!)');
                    document.getElementById('adminView').classList.add('hidden');
                    document.getElementById('adminAuthModal').classList.remove('hidden');
                    return false;
                }
                slots = JSON.parse(localStorage.getItem('lv_tutor_slots') || JSON.stringify(DEFAULT_SLOTS));
                leads = JSON.parse(localStorage.getItem('lv_tutor_leads') || '[]');
                journal = JSON.parse(localStorage.getItem('lv_tutor_journal') || JSON.stringify(DEFAULT_JOURNAL));
            }

            // 1. Отрисовка слотов
            const slotsBox = document.getElementById('adminSlotsList');
            slotsBox.innerHTML = '';
            slots.forEach(s => {
                const item = document.createElement('div');
                item.className = 'admin-item';
                item.innerHTML = `
                    <div style="display:flex; justify-content:space-between; align-items:center;">
                        <div>
                            <div style="font-weight:700; font-size:14px;">${s.day_label} • ${s.time_range}</div>
                            <div style="font-size:12px; color:var(--lv-muted); margin-top:2px;">
                                ${s.is_booked ? `Записан: <b>${s.booked_by_name \vert{}\vert{} 'Клиент'}</b> (${s.booked_by_tg || ''})` : 'Окно открыто для записи'}
                            </div>
                        </div>
                        <div style="display:flex; gap:6px; align-items:center;">
                            <span class="badge-status ${s.is_booked ? 'badge-booked' : 'badge-free'}">
                                ${s.is_booked ? 'Занят' : 'Свободен'}
                            </span>
                            <button onclick="toggleSlotStatus('${s.id}', ${s.is_booked})" style="padding:5px 8px; font-size:11px; border:1px solid var(--lv-gold); background:#fff; border-radius:6px; cursor:pointer;">
                                ${s.is_booked ? 'Освободить' : 'Закрыть'}
                            </button>
                            <button onclick="deleteSlot('${s.id}')" style="padding:5px 8px; font-size:11px; border:1px solid #ccc; background:#fff; color:var(--lv-danger); border-radius:6px; cursor:pointer;">✕</button>
                        </div>
                    </div>
                `;
                slotsBox.appendChild(item);
            });

            // 2. Отрисовка заявок
            const leadsBox = document.getElementById('adminLeadsList');
            leadsBox.innerHTML = leads.length ? '' : '<div style="font-size:13px; color:var(--lv-muted);">Пока новых заявок нет.</div>';
            leads.forEach(l => {
                const topicsStr = [...(l.topics || []), l.custom_topic].filter(Boolean).join(', ');
                const item = document.createElement('div');
                item.className = 'admin-item';
                item.innerHTML = `
                    <div style="display:flex; justify-content:space-between;">
                        <b style="font-size:15px;">${l.student_name}</b>
                        <a href="https://t.me/${(l.tg_username || '').replace('@','')}" target="_blank" style="color:var(--lv-gold); font-weight:700; font-size:13px;">${l.tg_username}</a>
                    </div>
                    <div style="font-size:12px; margin-top:6px;">
                        <b>Класс:</b> ${l.grade} | <b>Слот:</b> <span style="color:var(--lv-success); font-weight:600;">${l.slot_snapshot}</span><br>
                        <b>Тариф:</b> ${l.tariff}<br>
                        <b>Цель:</b> ${l.goal || '—'}<br>
                        <b>Темы:</b> ${topicsStr || '—'}
                    </div>
                `;
                leadsBox.appendChild(item);
            });

            // 3. Отрисовка личного журнала Тории
            const journalBox = document.getElementById('adminJournalList');
            journalBox.innerHTML = '';
            journal.forEach(j => {
                const item = document.createElement('div');
                item.className = 'admin-item';
                item.innerHTML = `
                    <div style="display:flex; justify-content:space-between; align-items:center;">
                        <b style="font-size:15px; color:var(--lv-dark);">${j.student_name}</b>
                        <span class="badge-status badge-free">Уроков в абонементе: ${j.lessons_left}</span>
                    </div>
                    <div style="font-size:12px; margin-top:8px;">
                        <div><b>Прошли на уроке:</b> ${j.last_topic || '—'}</div>
                        <div style="margin-top:4px; background:var(--lv-sand); padding:8px; border-radius:6px;">
                            <b>📌 Что задано (ДЗ):</b> ${j.homework || 'Без ДЗ'}
                        </div>
                    </div>
                    <div style="display:flex; gap:8px; margin-top:10px;">
                        <button onclick="decrementLesson('${j.id}')" style="flex:1; padding:7px; font-size:11px; font-weight:600; background:var(--lv-dark); color:var(--lv-gold); border:none; border-radius:6px; cursor:pointer;">
                            ✓ Урок проведен (-1 из абонемента)
                        </button>
                        <button onclick="deleteJournal('${j.id}')" style="padding:7px 10px; font-size:11px; background:#fff; border:1px solid #ccc; color:var(--lv-danger); border-radius:6px; cursor:pointer;">Удалить</button>
                    </div>
                `;
                journalBox.appendChild(item);
            });

            return true;
        }

        async function runAdminAction(action, payload, toastMsg) {
            if (sb) {
                const { data, error } = await sb.rpc('admin_manage_action', {
                    p_secret: adminSecretKey,
                    p_action: action,
                    p_payload: payload
                });
                if (error || !data?.success) {
                    showToast('Ошибка доступа!');
                    return;
                }
            } else {
                // Демо-режим
                if (action === 'add_slot') {
                    const slots = JSON.parse(localStorage.getItem('lv_tutor_slots') || JSON.stringify(DEFAULT_SLOTS));
                    slots.push({ id: 'slot-' + Date.now(), day_label: payload.day_label, time_range: payload.time_range, is_booked: false });
                    localStorage.setItem('lv_tutor_slots', JSON.stringify(slots));
                } else if (action === 'toggle_slot') {
                    const slots = JSON.parse(localStorage.getItem('lv_tutor_slots') || JSON.stringify(DEFAULT_SLOTS));
                    const s = slots.find(x => x.id === payload.id);
                    if (s) { s.is_booked = payload.next_booked; s.booked_by_name = s.is_booked ? 'Закрыто Торией' : ''; }
                    localStorage.setItem('lv_tutor_slots', JSON.stringify(slots));
                } else if (action === 'delete_slot') {
                    const slots = JSON.parse(localStorage.getItem('lv_tutor_slots') || JSON.stringify(DEFAULT_SLOTS)).filter(x => x.id !== payload.id);
                    localStorage.setItem('lv_tutor_slots', JSON.stringify(slots));
                } else if (action === 'add_journal') {
                    const list = JSON.parse(localStorage.getItem('lv_tutor_journal') || JSON.stringify(DEFAULT_JOURNAL));
                    list.unshift({ id: 'j-' + Date.now(), ...payload });
                    localStorage.setItem('lv_tutor_journal', JSON.stringify(list));
                } else if (action === 'dec_lesson') {
                    const list = JSON.parse(localStorage.getItem('lv_tutor_journal') || JSON.stringify(DEFAULT_JOURNAL));
                    const item = list.find(x => x.id === payload.id);
                    if (item) item.lessons_left = Math.max(0, (item.lessons_left || 1) - 1);
                    localStorage.setItem('lv_tutor_journal', JSON.stringify(list));
                } else if (action === 'delete_journal') {
                    const list = JSON.parse(localStorage.getItem('lv_tutor_journal') || JSON.stringify(DEFAULT_JOURNAL)).filter(x => x.id !== payload.id);
                    localStorage.setItem('lv_tutor_journal', JSON.stringify(list));
                }
            }
            if (toastMsg) showToast(toastMsg);
            renderAdminDashboard();
        }

        function addAdminSlot() {
            const day = document.getElementById('newSlotDay').value.trim();
            const time = document.getElementById('newSlotTime').value.trim();
            if (!day || !time) return showToast('Заполни день и время слота');
            document.getElementById('newSlotDay').value = '';
            document.getElementById('newSlotTime').value = '';
            runAdminAction('add_slot', { day_label: day, time_range: time }, 'Слот добавлен');
        }

        function toggleSlotStatus(id, currentBooked) {
            runAdminAction('toggle_slot', { id, next_booked: !currentBooked });
        }

        function deleteSlot(id) {
            runAdminAction('delete_slot', { id });
        }

        function addJournalEntry() {
            const student_name = document.getElementById('jStudentName').value.trim();
            const lessons_left = parseInt(document.getElementById('jLessonsLeft').value || '1', 10);
            const last_topic = document.getElementById('jLastTopic').value.trim();
            const homework = document.getElementById('jHomework').value.trim();
            if (!student_name) return showToast('Впиши имя ученика');
            document.getElementById('jStudentName').value = '';
            document.getElementById('jLastTopic').value = '';
            document.getElementById('jHomework').value = '';
            runAdminAction('add_journal', { student_name, lessons_left, last_topic, homework }, 'Сохранено в журнал');
        }

        function decrementLesson(id) {
            runAdminAction('dec_lesson', { id }, 'Списан 1 урок');
        }

        function deleteJournal(id) {
            runAdminAction('delete_journal', { id });
        }
    </script>
</body>
</html>
